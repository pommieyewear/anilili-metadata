[{"number":1.0,"title":"The Power of Bonds","overview":"Aspiring young Rider Lute and friends go in search of a Monstie Egg on the eve of the Kinship Rite. A search that takes them into dangerous territory.","air_date":"2016-10-02","still":"https://image.tmdb.org/t/p/w500/su99zjs5ngbRYoapEOonJMzVJrm.jpg","runtime":24},{"number":2.0,"title":"A Monstie Is Born!","overview":"It's Kinship Rite time! Lilia and Cheval are uncertain about their futures, while an unexpected attack on Hakum Village sends its Riders scrambling.","air_date":"2016-10-09","still":"https://image.tmdb.org/t/p/w500/yuMhlTKhFNoHjmGxINzphVixiad.jpg","runtime":24},{"number":3.0,"title":"Absolute Power","overview":"A Hunter is headed for secretive Hakum Village. He's sure to have his own way of dealing with all these monsters showing up where they don't belong...","air_date":"2016-10-16","still":"https://image.tmdb.org/t/p/w500/2DTZXtDfHwrvoJzI6aPFTquJpHC.jpg","runtime":24},{"number":4.0,"title":"The Kinship Rite","overview":"Chief Omna sends the apprentice Riders off in search of the Waterfall of Trials. A visitor to Hakum Village gives Lilia inspiration for her future.","air_date":"2016-10-23","still":"https://image.tmdb.org/t/p/w500/k4L6po67Ci6yR04eeNDiUXY5JA8.jpg","runtime":24},{"number":5.0,"title":"Off to the Monstie Races","overview":"Hakum Village revives the beloved Monstie Races for their four newest Riders, but Lute could still use a lot more practice piloting his powerful pal.","air_date":"2016-10-30","still":"https://image.tmdb.org/t/p/w500/g41PkrBOgrt7sw7v5sjxMsi0BZ0.jpg","runtime":24},{"number":6.0,"title":"Quest for the Golden Egg","overview":"Lute and friends dream about what they'd buy with the proceeds from a rare and valuable golden Gargwa egg, and Cheval decides to try hunting one down.","air_date":"2016-11-06","still":"https://image.tmdb.org/t/p/w500/h60O0XdFTaGvkazndJZhe7W0B3V.jpg","runtime":24},{"number":7.0,"title":"Like Mom Used to Make","overview":"The mischievous twins Den-Den and Lin-Lin are stirring up trouble in Hakum Village--and run into trouble of their own in the forboding woods at night.","air_date":"2016-11-13","still":"https://image.tmdb.org/t/p/w500/kIp0fcFU5m0yHmJz6L0xdgQHRqj.jpg","runtime":24},{"number":8.0,"title":"Navirou in Love","overview":"Ms. Pink the traveling merchant stops by the village, and Navirou falls hard for her Felyne assistant Mocha. How far will he go in the name of love?","air_date":"2016-11-20","still":"https://image.tmdb.org/t/p/w500/hGMR6xcdeL4kFixrqMbuKYdnIYo.jpg","runtime":24},{"number":9.0,"title":"DSZ (Dan and Silva's Zeal!)","overview":"Dan has doubts about whether he should be leading the Riders in training, and remembers his old friend Silva, who was once a shoo-in to be the leader.","air_date":"2016-11-27","still":"https://image.tmdb.org/t/p/w500/jCf2CE5GWRfnQrJF9Hhyo3zsjSC.jpg","runtime":24},{"number":10.0,"title":"Portent of Disaster","overview":"In the latest ill omen, the village's beneficial wind turns violent. Hyoro struggles to live up to the expectations of his demanding brother Genie.","air_date":"2016-12-04","still":"https://image.tmdb.org/t/p/w500/3WSgXYVTd8hUDsT5HXqpRS3UmEG.jpg","runtime":24},{"number":11.0,"title":"Before the Storm","overview":null,"air_date":"2016-12-11","still":"https://image.tmdb.org/t/p/w500/ex0qGeJSFjqVJMWaoAGj6d1vADO.jpg","runtime":24},{"number":12.0,"title":"Invasion of the Nargacuga","overview":null,"air_date":"2016-12-18","still":"https://image.tmdb.org/t/p/w500/wOyi63B2ksyIUnEo1tuxJkpr4yh.jpg","runtime":24},{"number":13.0,"title":"A Rathian Is Born!","overview":null,"air_date":"2016-12-25","still":"https://image.tmdb.org/t/p/w500/2redL4Fkzs8jFL3hokqs80SkZI6.jpg","runtime":24},{"number":14.0,"title":"Face the Black Blight","overview":null,"air_date":"2017-01-08","still":"https://image.tmdb.org/t/p/w500/1HN8MLfyK09e36lAqolewQRseH2.jpg","runtime":24},{"number":15.0,"title":"The Journey Begins","overview":null,"air_date":"2017-01-15","still":"https://image.