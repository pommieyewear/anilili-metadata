[{"number":1.0,"title":"Fantine and Cosette","overview":"Fantine unsuccessfully searches for a job in Montfermeil alongside her three-year-old daughter, Cosette, and eventually drops Cosette off under the care of the Thénardier family, while she travels to the economically-thriving town of Montreuil-sur-Mer. Little does Fantine know, the Thénardiers are a wicked and abusive family, who force Cosette into hard labor, while Cosette waits for the return of her mother.","air_date":"2007-01-07","still":"https://image.tmdb.org/t/p/w500/6KJVID4pkNhwmHRSGYy6wE2W5jq.jpg","runtime":24},{"number":2.0,"title":"Jean Valjean's Secret","overview":null,"air_date":"2007-01-14","still":"https://image.tmdb.org/t/p/w500/eAeAaOqdQVorJEFlxN1DswjwRXj.jpg","runtime":24},{"number":3.0,"title":"A New Friend, Chou Chou","overview":null,"air_date":"2007-01-21","still":"https://image.tmdb.org/t/p/w500/65JtDAxuxg6Z1yrwL7t8RBIwyel.jpg","runtime":24},{"number":4.0,"title":"Mother's Letter","overview":null,"air_date":"2007-01-28","still":"https://image.tmdb.org/t/p/w500/mKc8fYsnqVZQr6IMqWGbf9otszY.jpg","runtime":24},{"number":5.0,"title":"Javert's Suspicions","overview":null,"air_date":"2007-02-04","still":"https://image.tmdb.org/t/p/w500/7a2YwwZEoaUwE3nOHv8goNSzcFR.jpg","runtime":24},{"number":6.0,"title":"Cosette's Birthday","overview":null,"air_date":"2007-02-11","still":"https://image.tmdb.org/t/p/w500/aouc0AVR0jv1hOlu7jDVme2O6DK.jpg","runtime":24},{"number":7.0,"title":"Lost Eponine","overview":null,"air_date":"2007-02-18","still":"https://image.tmdb.org/t/p/w500/vmdzpzykiv2rRGl8nkj7f9jgckZ.jpg","runtime":24},{"number":8.0,"title":"Mother's Skirt","overview":null,"air_date":"2007-02-25","still":"https://image.tmdb.org/t/p/w500/sHg37Ahi2qkwmnW93z56i03hItj.jpg","runtime":24},{"number":9.0,"title":"Thenardier's Malice","overview":null,"air_date":"2007-03-04","still":"https://image.tmdb.org/t/p/w500/vFsrPsLAx6e8srQJbsxxU9AMd8H.jpg","runtime":24},{"number":10.0,"title":"Madeleine Is Perplexed","ove