[{"number":1.0,"title":"The Strongest Cat is Born!","overview":"Kuro wakes up in Dr. Go's lab after being kidnapped and repaired to become a cyborg. However, Kuro manages to break his control chip, and he sets off to return to his owners' home.","air_date":"1999-10-02","still":null,"runtime":24},{"number":2.0,"title":"Nyan-Nyan Army","overview":"Kuro and his owners are invited to a contest at a local store. Kuro, however, realizes this as a ruse set up by Dr. Go and his army of robot cats.","air_date":"1999-10-09","still":null,"runtime":24},{"number":3.0,"title":"Hell Highway","overview":"Dr. Go creates a chip that allows Mi to penetrate metal objects and transform them at will. Mi goes out of control with this and eventually becomes a mechanically engineered automobile, which Kuro cannot defeat alone.","air_date":"1999-10-16","still":null,"runtime":24},{"number":4.0,"title":"Appearance of the Flying Robot Family!","overview":"Dr. Go constructs two robots: Big Sam and Little Sam. He accidentally sets off a self-destruct bomb and is trapped inside. Kuro and Mi work together to try to deactivate the bomb and save the doctor, who, by that time, has already escaped.","air_date":"1999-10-23","still":null,"runtime":24},{"number":5.0,"title":"M's First Love","overview":"Mi falls in love with one of the dogs in the neighborhood, but he does not have the courage to speak to her, and he disguises himself as a dog to try to do so. Meanwhile, another of Dr. Go's inventions causes chaos, and endangers the dog.","air_date":"1999-10-30","still":null,"runtime":24},{"number":6.0,"title":"The Case of M's Abduction","overview":null,"air_date":"1999-11-06","still":null,"runtime":24},{"number":7.0,"title":"Episode 7","overview":null,"air_date":"1999-11-13","still":null,"runtime":24},{"number":8.0,"title":"Episode 8","overview":null,"air_date":"1999-11-20","still":null,"runtime":24},{"number":9.0,"title":"The Legend Behind the School","overview":null,"air_date":"1999-11-27","still":null,